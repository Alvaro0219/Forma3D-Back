# Runtime
NODE_ENV=development
PORT=4000

# Database
MONGO_URL=mongodb://localhost:27017/impresion3d

# Auth
JWT_SECRET=change_me_dev_secret_min16
JWT_EXPIRES_IN=1d
REFRESH_SECRET=change_me_dev_refresh_min16
REFRESH_EXPIRES_IN=7d

# CORS (origenes permitidos, separados por coma)
CORS_ORIGINS=http://localhost:5173

# Bootstrap del primer admin (opcional; se crea al arrancar si no existe ningun usuario)
BOOTSTRAP_ADMIN_EMAIL=admin@impresion3d.local
BOOTSTRAP_ADMIN_PASSWORD=admin1234
BOOTSTRAP_ADMIN_NAME=Administrador

# Almacenamiento de imagenes en Cloudflare R2 (S3-compatible).
# Requeridas en produccion (el proceso falla al arrancar si faltan con NODE_ENV=production).
# En desarrollo son opcionales, pero necesarias para probar la subida de imagenes.
R2_ACCOUNT_ID=          # Account ID de Cloudflare (dashboard R2)
R2_ACCESS_KEY_ID=       # Access Key del API Token de R2
R2_SECRET_ACCESS_KEY=   # Secret Access Key del API Token de R2
R2_BUCKET_NAME=
# URL publica desde donde se sirven las imagenes.
# En local para probar: usar el subdominio r2.dev del bucket (Public Development URL),
# ej. https://pub-xxxxxxxx.r2.dev
# En produccion: un dominio propio conectado via Cloudflare, ej. https://cdn.tu-dominio.com
R2_PUBLIC_URL=
