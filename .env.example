# Runtime
NODE_ENV=development
PORT=4000

# Database
# Usar un usuario de Mongo distinto para cada base, con permisos solo sobre la suya.
MONGO_URL=mongodb://localhost:27017/impresion3d

# Auth
# Generar SIEMPRE con: npm run gen:secrets
# Minimo 32 caracteres y no pueden contener "change_me": el arranque los rechaza.
# Los de produccion deben ser distintos a los de desarrollo.
JWT_SECRET=
JWT_EXPIRES_IN=1d
REFRESH_SECRET=
REFRESH_EXPIRES_IN=7d

# CORS (origenes permitidos, separados por coma)
# Obligatorio en produccion: es una lista blanca estricta, un origen que no este
# aca recibe 403. Poner el dominio final del frontend, sin barra al final.
#   prod -> https://tienda.tu-dominio.com,https://www.tu-dominio.com
CORS_ORIGINS=http://localhost:5173

# Bootstrap del primer admin: se crea al arrancar SOLO si la coleccion users esta vacia.
# En produccion, poner aca el email y una contraseña fuerte (10+) del admin real.
# Despues del primer arranque conviene cambiarla desde la app (menu de usuario ->
# "Cambiar contraseña") y vaciar estas variables.
BOOTSTRAP_ADMIN_EMAIL=admin@impresion3d.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador

# Almacenamiento de imagenes en Cloudflare R2 (S3-compatible).
# Requeridas en produccion (el proceso falla al arrancar si faltan con NODE_ENV=production).
# En desarrollo son opcionales, pero necesarias para probar la subida de imagenes.
# Usar un API Token de R2 distinto para produccion.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL publica desde donde se sirven las imagenes.
# En local para probar: el subdominio r2.dev del bucket, ej. https://pub-xxxxxxxx.r2.dev
# En produccion: un dominio propio conectado via Cloudflare, ej. https://cdn.tu-dominio.com
R2_PUBLIC_URL=
